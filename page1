body {
    font-family: 'Georgia', serif;
    background-color: #fdfbf7;
    color: #4a3e3d;
    margin: 0;
    padding: 0;
    line-height: 1.7;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

main {
    max-width: 800px;
    width: 100%;
    margin: 40px auto;
    padding: 0 20px;
    flex: 1;
}

header {
    background-color: #f3e9dc;
    padding: 30px 20px;
    text-align: center;
    border-bottom: 2px solid #e1cdb5;
}

header h1 {
    margin: 0 0 20px 0;
    color: #8c6239;
    font-size: 32px;
}

nav a {
    color: #6d4c41;
    text-decoration: none;
    margin: 0 15px;
    font-weight: bold;
    font-size: 16px;
    padding-bottom: 5px;
    transition: all 0.3s ease;
}

nav a:hover {
    color: #d4a373;
}

nav a.active {
    color: #b56576;
    border-bottom: 2px solid #b56576;
}

h2 {
    color: #8c6239;
    border-bottom: 1px solid #e1cdb5;
    padding-bottom: 10px;
}

h3, h4 {
    color: #b56576;
}

.recipe-card {
    background-color: #fff;
    padding: 25px;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    border-left: 4px solid #b56576;
    margin-top: 20px;
}

.gallery {
    display: flex;
    gap: 15px;
    margin: 20px 0;
}

.gallery-item {
    flex: 1;
    background-color: #f3e9dc;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 10px;
    border-radius: 6px;
    border: 1px dashed #8c6239;
    font-style: italic;
    font-size: 14px;
}

.movies-section {
    margin-top: 40px;
}

ul, ol {
    padding-left: 20px;
}

li {
    margin-bottom: 8px;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    background-color: #fff;
}

th, td {
    border: 1px solid #e1cdb5;
    padding: 12px;
    text-align: left;
}

th {
    background-color: #f3e9dc;
    color: #6d4c41;
}

tr:nth-child(even) {
    background-color: #fbf8f3;
}

footer {
    background-color: #4a3e3d;
    color: #fdfbf7;
    text-align: center;
    padding: 15px;
    font-size: 14px;
    margin-top: auto;
}

.recipe-image-container {
    text-align: center;
    margin: 20px 0 30px 0;
}

.recipe-image {
    max-width: 100%;
    height: auto;
    max-height: 400px;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

.image-caption {
    font-style: italic;
    font-size: 14px;
    color: #6d4c41;
    margin-top: 8px;
}

.ingredients-box h5 {
    margin: 15px 0 5px 0;
    color: #8c6239;
    font-size: 16px;
}

.recipe-steps li {
    margin-bottom: 15px;
}

.recipe-ps {
    background-color: #fffaf1;
    padding: 10px 15px;
    border-radius: 6px;
    border: 1px dashed #b56576;
    margin-top: 25px;
    font-style: italic;
}

.knitting-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 15px;
    margin: 25px 0;
}

.knitting-item {
    background-color: #fff;
    padding: 10px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    text-align: center;
    border: 1px solid #e1cdb5;
}

.gallery-img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-radius: 4px;
}

.img-desc {
    font-size: 13px;
    color: #6d4c41;
    margin: 8px 0 0 0;
    font-style: italic;
}

.movie-content {
    display: flex;
    gap: 30px;
    align-items: flex-start;
    margin-top: 25px;
}

@media (max-width: 600px) {
    .movie-content {
        flex-direction: column;
    }

    .movie-poster-box {
        width: 100%;
        text-align: center;
    }
}

.movie-poster-box {
    flex: 1;
    max-width: 250px;
    background-color: #fff;
    padding: 10px;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
    border: 1px solid #e1cdb5;
}

.movie-img {
    width: 100%;
    height: auto;
    border-radius: 4px;
}

.movie-ratings {
    flex: 2;
    list-style: none;
    padding: 0;
    margin: 0;
}

.movie-ratings li {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px dashed #e1cdb5;
}

.movie-title {
    font-weight: bold;
    color: #4a3e3d;
}

.rating {
    background-color: #b56576;
    color: #fff;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 14px;
    font-family: sans-serif;
    font-weight: bold;
}
